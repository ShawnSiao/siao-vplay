{
  "$defs": {
    "CollectionKind": {
      "enum": [
        "series",
        "folder",
        "manual"
      ],
      "type": "string"
    },
    "CollectionSortMode": {
      "enum": [
        "episode",
        "natural",
        "manual",
        "added_at"
      ],
      "type": "string"
    },
    "CollectionSummary": {
      "properties": {
        "autoPlayNext": {
          "type": "boolean"
        },
        "createdAtMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "itemCount": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/CollectionKind"
        },
        "lastOpenedAtMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "posterPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "rootId": {
          "type": [
            "string",
            "null"
          ]
        },
        "seasonCount": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "sortMode": {
          "$ref": "#/$defs/CollectionSortMode"
        },
        "systemKey": {
          "anyOf": [
            {
              "$ref": "#/$defs/CollectionSystemKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "totalDurationMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "updatedAtMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "watchedCount": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "rootId",
        "systemKey",
        "posterPath",
        "sortMode",
        "autoPlayNext",
        "lastOpenedAtMs",
        "createdAtMs",
        "updatedAtMs",
        "itemCount",
        "seasonCount",
        "watchedCount",
        "totalDurationMs"
      ],
      "type": "object"
    },
    "CollectionSystemKey": {
      "enum": [
        "watch_later"
      ],
      "type": "string"
    },
    "OverviewScope": {
      "enum": [
        "collections",
        "roots"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
    {
      "items": [],
      "nextOffset": null,
      "offset": 0,
      "query": "",
      "rootLinked": false,
      "scope": "collections",
      "snapshotToken": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "totalCount": 0
    }
  ],
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/CollectionSummary"
      },
      "maxItems": 24,
      "type": "array"
    },
    "nextOffset": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "offset": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "query": {
      "type": "string"
    },
    "rootLinked": {
      "type": "boolean"
    },
    "scope": {
      "$ref": "#/$defs/OverviewScope"
    },
    "snapshotToken": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "totalCount": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "scope",
    "rootLinked",
    "query",
    "offset",
    "snapshotToken",
    "totalCount",
    "nextOffset",
    "items"
  ],
  "title": "CollectionOverviewPage",
  "type": "object"
}
