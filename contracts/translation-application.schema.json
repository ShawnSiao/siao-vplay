{
  "$defs": {
    "Handoff": {
      "enum": [
        "manual",
        "codex",
        "api"
      ],
      "type": "string"
    },
    "SubtitleCorrection": {
      "enum": [
        "missing",
        "duplicate",
        "incorrect"
      ],
      "type": "string"
    },
    "SubtitleIssueCode": {
      "enum": [
        "empty_text",
        "invalid_timing",
        "out_of_order",
        "out_of_bounds",
        "overlap",
        "long_gap",
        "duration_too_short",
        "duration_too_long",
        "reading_speed_high"
      ],
      "type": "string"
    },
    "SubtitleIssueSeverity": {
      "enum": [
        "error",
        "warning"
      ],
      "type": "string"
    },
    "SubtitlePreflightIssue": {
      "properties": {
        "code": {
          "$ref": "#/$defs/SubtitleIssueCode"
        },
        "message": {
          "type": "string"
        },
        "ordinal": {
          "format": "uint",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "relatedOrdinal": {
          "format": "uint",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/$defs/SubtitleIssueSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "ordinal",
        "relatedOrdinal",
        "message"
      ],
      "type": "object"
    },
    "SubtitlePreflightReport": {
      "properties": {
        "coverageRatio": {
          "format": "double",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "errorCount": {
          "format": "uint",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "firstStartMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": [
            "integer",
            "null"
          ]
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/SubtitlePreflightIssue"
          },
          "type": "array"
        },
        "lastEndMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": [
            "integer",
            "null"
          ]
        },
        "mediaDurationMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": [
            "integer",
            "null"
          ]
        },
        "segmentCount": {
          "format": "uint",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/SubtitlePreflightStatus"
        },
        "warningCount": {
          "format": "uint",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "status",
        "segmentCount",
        "errorCount",
        "warningCount",
        "firstStartMs",
        "lastEndMs",
        "mediaDurationMs",
        "coverageRatio",
        "issues"
      ],
      "type": "object"
    },
    "SubtitlePreflightStatus": {
      "enum": [
        "ready",
        "warning",
        "blocked"
      ],
      "type": "string"
    },
    "SubtitleRevisionStatus": {
      "enum": [
        "draft",
        "ready",
        "rejected"
      ],
      "type": "string"
    },
    "SubtitleSegment": {
      "properties": {
        "confidence": {
          "format": "double",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "endMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "issueKind": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubtitleCorrection"
            },
            {
              "type": "null"
            }
          ]
        },
        "lineageId": {
          "type": "string"
        },
        "ordinal": {
          "format": "uint",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "sourceSegmentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "startMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/SubtitleWord"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "lineageId",
        "sourceSegmentId",
        "ordinal",
        "startMs",
        "endMs",
        "text",
        "confidence",
        "issueKind",
        "words"
      ],
      "type": "object"
    },
    "SubtitleSource": {
      "enum": [
        "imported_file",
        "embedded",
        "transcription",
        "agent_translation"
      ],
      "type": "string"
    },
    "SubtitleTrackRole": {
      "enum": [
        "original",
        "translation"
      ],
      "type": "string"
    },
    "SubtitleVersion": {
      "properties": {
        "createdAtMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "isCurrent": {
          "type": "boolean"
        },
        "languageCode": {
          "type": "string"
        },
        "mediaSha256": {
          "type": "string"
        },
        "parentVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "preflight": {
          "$ref": "#/$defs/SubtitlePreflightReport"
        },
        "projectId": {
          "type": "string"
        },
        "projectRevision": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/SubtitleTrackRole"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/SubtitleSegment"
          },
          "type": "array"
        },
        "sourceKind": {
          "$ref": "#/$defs/SubtitleSource"
        },
        "sourceLabel": {
          "type": "string"
        },
        "sourceSha256": {
          "type": "string"
        },
        "sourceTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/SubtitleRevisionStatus"
        },
        "trackId": {
          "type": "string"
        },
        "versionNumber": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "trackId",
        "projectId",
        "role",
        "versionNumber",
        "status",
        "sourceKind",
        "sourceLabel",
        "sourceSha256",
        "mediaSha256",
        "languageCode",
        "projectRevision",
        "parentVersionId",
        "sourceTaskId",
        "preflight",
        "createdAtMs",
        "isCurrent",
        "segments"
      ],
      "type": "object"
    },
    "SubtitleWord": {
      "properties": {
        "confidence": {
          "format": "double",
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "endMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "ordinal": {
          "format": "uint",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "startMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "ordinal",
        "startMs",
        "endMs",
        "text",
        "confidence"
      ],
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "awaiting_external_result",
        "queued",
        "running",
        "validating",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "type": "string"
    },
    "TaskType": {
      "enum": [
        "subtitle_translation"
      ],
      "type": "string"
    },
    "TranslationTask": {
      "properties": {
        "authorizedSegmentIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "baseTranslationVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "completedAtMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": [
            "integer",
            "null"
          ]
        },
        "createdAtMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "errorMessage": {
          "type": [
            "string",
            "null"
          ]
        },
        "expectedProjectRevision": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "handoffKind": {
          "$ref": "#/$defs/Handoff"
        },
        "id": {
          "type": "string"
        },
        "materialScope": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "outputVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "format": "double",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "projectId": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "string"
        },
        "receiverLabel": {
          "type": "string"
        },
        "segmentCount": {
          "format": "uint",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "sourceLanguageCode": {
          "type": "string"
        },
        "sourceVersionId": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "startedAtMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "targetLanguageCode": {
          "type": "string"
        },
        "taskType": {
          "$ref": "#/$defs/TaskType"
        },
        "updatedAtMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "validation": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranslationValidation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "projectId",
        "taskType",
        "handoffKind",
        "protocolVersion",
        "status",
        "stage",
        "progress",
        "receiverLabel",
        "materialScope",
        "sourceVersionId",
        "sourceLanguageCode",
        "targetLanguageCode",
        "authorizedSegmentIds",
        "segmentCount",
        "expectedProjectRevision",
        "baseTranslationVersionId",
        "outputVersionId",
        "validation",
        "errorCode",
        "errorMessage",
        "createdAtMs",
        "updatedAtMs",
        "startedAtMs",
        "completedAtMs"
      ],
      "type": "object"
    },
    "TranslationValidation": {
      "properties": {
        "status": {
          "$ref": "#/$defs/ValidationStatus"
        },
        "translationCount": {
          "format": "uint",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "warningCount": {
          "format": "uint",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "status",
        "translationCount",
        "warningCount",
        "warnings"
      ],
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "accepted",
        "accepted_with_warnings"
      ],
      "type": "string"
    }
  },
