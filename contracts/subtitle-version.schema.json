          "type": [
            "number",
            "null"
          ]
        },
        "endMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "issueKind": {
          "anyOf": [
