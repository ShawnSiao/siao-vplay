{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assetCount": {
      "format": "uint",
      "maximum": 12,
      "minimum": 0,
      "type": "integer"
    },
    "directory": {
      "type": "string"
    },
    "manifestPath": {
      "type": "string"
    },
    "reportPath": {
      "type": "string"
    },
    "reportSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "summaryId": {
      "type": "string"
    }
  },
  "required": [
    "summaryId",
    "directory",
    "reportPath",
    "manifestPath",
    "assetCount",
    "reportSha256"
  ],
  "title": "SummaryExport",
  "type": "object"
}
