{
  "$defs": {
    "AudioStream": {
      "properties": {
        "channels": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "codecName": {
          "type": "string"
        },
        "durationMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "index": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "sampleRateHz": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "index",
        "codecName",
        "channels",
        "sampleRateHz",
        "durationMs"
      ],
      "type": "object"
    },
    "EmbeddedSubtitleKind": {
      "enum": [
        "text",
        "image",
        "unknown"
      ],
      "type": "string"
    },
    "MediaArtifact": {
      "properties": {
        "createdAtMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        },
        "errorMessage": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "sourceMediaId": {
          "type": "string"
        },
        "sourceSha256": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MediaArtifactStatus"
        },
        "updatedAtMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "projectId",
        "sourceMediaId",
        "status",
        "path",
        "sourceSha256",
        "profile",
        "errorCode",
        "errorMessage",
        "createdAtMs",
        "updatedAtMs"
      ],
      "type": "object"
    },
    "MediaArtifactStatus": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "interrupted"
      ],
      "type": "string"
    },
    "MediaInspection": {
      "properties": {
        "ffmpegVersion": {
          "type": "string"
        },
        "mediaSourceId": {
          "type": "string"
        },
        "playbackGate": {
          "$ref": "#/$defs/PlaybackGate"
        },
        "probe": {
          "$ref": "#/$defs/MediaProbe"
        },
        "projectId": {
          "type": "string"
        },
        "reusedProbe": {
          "type": "boolean"
        },
        "sourceSha256": {
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "mediaSourceId",
        "sourceSha256",
        "probe",
        "playbackGate",
        "ffmpegVersion",
        "reusedProbe"
      ],
      "type": "object"
    },
    "MediaProbe": {
      "properties": {
        "audioStreams": {
          "items": {
            "$ref": "#/$defs/AudioStream"
          },
          "type": "array"
        },
        "bitRate": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "containerFormats": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "durationMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sizeBytes": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "subtitleStreams": {
          "items": {
            "$ref": "#/$defs/SubtitleStream"
          },
          "type": "array"
        },
        "videoStreams": {
          "items": {
            "$ref": "#/$defs/VideoStream"
          },
          "type": "array"
        }
      },
      "required": [
        "containerFormats",
        "durationMs",
        "sizeBytes",
        "bitRate",
        "videoStreams",
        "audioStreams",
        "subtitleStreams"
      ],
      "type": "object"
    },
    "PlaybackDecision": {
      "enum": [
        "direct",
        "runtime_validation_required",
        "proxy_required",
        "unsupported"
      ],
      "type": "string"
    },
    "PlaybackGate": {
      "properties": {
        "decision": {
          "$ref": "#/$defs/PlaybackDecision"
        },
        "reasonCodes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "requiresRuntimeVideoCheck": {
          "type": "boolean"
        }
      },
      "required": [
        "decision",
        "reasonCodes",
        "requiresRuntimeVideoCheck"
      ],
      "type": "object"
    },
    "PlaybackSourceKind": {
      "enum": [
        "original",
        "proxy"
      ],
      "type": "string"
    },
    "SubtitleStream": {
      "properties": {
        "codecName": {
          "type": "string"
        },
        "index": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/EmbeddedSubtitleKind",
          "default": "unknown"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "index",
        "codecName",
        "language",
        "kind"
      ],
      "type": "object"
    },
    "VideoStream": {
      "properties": {
        "codecName": {
          "type": "string"
        },
        "durationMs": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "frameRate": {
          "format": "double",
          "maximum": 9007199254740991.0,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "height": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "index": {
          "format": "int64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "pixelFormat": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "index",
        "codecName",
        "profile",
        "pixelFormat",
        "width",
        "height",
        "frameRate",
        "durationMs"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "inspection": {
      "$ref": "#/$defs/MediaInspection"
    },
    "playbackPath": {
      "type": "string"
    },
    "playbackSourceKind": {
      "$ref": "#/$defs/PlaybackSourceKind"
    },
    "proxyArtifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/MediaArtifact"
        },
        {
          "type": "null"
        }
      ]
    },
    "reusedProxy": {
      "type": "boolean"
    }
  },
  "required": [
    "inspection",
    "playbackSourceKind",
    "playbackPath",
    "proxyArtifact",
    "reusedProxy"
  ],
  "title": "MediaPreparation",
  "type": "object"
}
