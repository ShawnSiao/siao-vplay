{
  "$defs": {
    "AiProtocol": {
      "enum": [
        "openai_responses",
        "anthropic_messages",
        "gemini_generate_content",
        "openai_chat_completions"
      ],
      "type": "string"
    },
    "AiProviderCatalog": {
      "properties": {
        "providers": {
          "items": {
            "$ref": "#/$defs/AiProviderCatalogEntry"
          },
          "type": "array"
        },
        "schemaVersion": {
          "format": "uint32",
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schemaVersion",
        "providers"
      ],
      "type": "object"
    },
    "AiProviderCatalogEntry": {
      "properties": {
        "displayName": {
          "type": "string"
        },
        "documentationUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/AiProviderId"
        },
        "modelsPath": {
          "type": "string"
        },
        "officialBaseUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol": {
          "$ref": "#/$defs/AiProtocol"
        },
        "supportsModelDiscovery": {
          "type": "boolean"
        },
        "visionModelPrefixes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "displayName",
        "protocol",
        "officialBaseUrl",
        "modelsPath",
        "documentationUrl",
        "supportsModelDiscovery",
        "visionModelPrefixes"
      ],
      "type": "object"
    },
    "AiProviderId": {
      "enum": [
        "openai",
        "anthropic",
        "gemini",
        "deepseek",
        "kimi",
        "glm",
        "custom"
      ],
      "type": "string"
    },
    "AiServiceCapabilities": {
      "properties": {
        "learning": {
          "type": "boolean"
        },
        "understanding": {
          "type": "boolean"
        },
        "vision": {
          "type": "boolean"
        }
      },
      "required": [
        "understanding",
        "learning",
        "vision"
      ],
      "type": "object"
    },
    "AiServiceSummary": {
      "properties": {
        "baseUrl": {
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/AiServiceCapabilities"
        },
        "connectionState": {
          "$ref": "#/$defs/ConnectionState"
        },
        "credentialState": {
          "$ref": "#/$defs/CredentialState"
        },
        "displayName": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "isDefault": {
          "type": "boolean"
        },
        "modelId": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol": {
          "$ref": "#/$defs/AiProtocol"
        },
        "providerId": {
          "$ref": "#/$defs/AiProviderId"
        },
        "revision": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "providerId",
        "displayName",
        "protocol",
        "baseUrl",
        "modelId",
        "credentialState",
        "connectionState",
        "capabilities",
        "isDefault",
        "revision"
      ],
      "type": "object"
    },
    "ConnectionState": {
      "enum": [
        "untested",
        "ready",
        "error"
      ],
      "type": "string"
    },
    "CredentialState": {
      "enum": [
        "missing",
        "stored"
      ],
      "type": "string"
    }
  },
