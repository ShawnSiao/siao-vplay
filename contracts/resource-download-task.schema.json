{
  "$defs": {
    "ResourceDownloadTaskState": {
      "enum": [
        "queued",
        "downloading",
        "paused",
        "verifying",
        "installing",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "attempt": {
      "format": "uint32",
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "createdAtMs": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "downloadedBytes": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "errorMessage": {
      "type": [
        "string",
        "null"
      ]
    },
    "forceReinstall": {
      "default": false,
      "type": "boolean"
    },
    "generation": {
      "default": 0,
      "description": "Process-local root binding and mutation order, reissued when the store loads.",
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "pendingActionIds": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "requestedByCapabilityIds": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "resourceId": {
      "type": "string"
    },
    "revision": {
      "default": 0,
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/ResourceDownloadTaskState"
    },
    "totalBytes": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "updatedAtMs": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "generation",
    "revision",
    "id",
    "resourceId",
    "version",
    "state",
    "downloadedBytes",
    "totalBytes",
    "requestedByCapabilityIds",
    "pendingActionIds",
    "attempt",
    "errorCode",
    "errorMessage",
    "createdAtMs",
    "updatedAtMs",
    "forceReinstall"
  ],
  "title": "ResourceDownloadTask",
  "type": "object"
}
