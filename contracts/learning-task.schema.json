{
  "$defs": {
    "AiExecutionKind": {
      "enum": [
        "manual",
        "codex",
        "api"
      ],
      "type": "string"
    },
    "AiTaskExecutionInfo": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/AiExecutionKind"
        },
        "modelId": {
          "type": [
            "string",
            "null"
          ]
        },
        "providerId": {
          "type": [
            "string",
            "null"
          ]
        },
        "providerRequestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "serviceConfigId": {
          "type": [
            "string",
            "null"
          ]
        },
        "serviceRevision": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "usage": true
      },
      "required": [
        "kind",
        "serviceConfigId",
        "serviceRevision",
        "providerId",
        "modelId",
        "providerRequestId",
        "usage"
      ],
      "type": "object"
    },
    "Handoff": {
      "enum": [
        "manual",
        "codex",
        "api"
      ],
      "type": "string"
    },
    "SelectionKind": {
      "enum": [
        "word",
        "phrase",
        "sentence"
      ],
      "type": "string"
    },
    "TaskStatus": {
      "enum": [
        "awaiting_external_result",
        "queued",
        "running",
        "validating",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "completedAtMs": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": [
        "integer",
        "null"
      ]
    },
    "createdAtMs": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "errorMessage": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution": {
      "$ref": "#/$defs/AiTaskExecutionInfo"
    },
    "expectedProjectRevision": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "handoffKind": {
      "$ref": "#/$defs/Handoff"
    },
    "id": {
      "type": "string"
    },
    "materialScope": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "outputDictionaryEntryId": {
      "type": [
        "string",
        "null"
      ]
    },
    "playbackPositionMs": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "progress": {
      "format": "double",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "projectId": {
      "type": "string"
    },
    "protocolVersion": {
      "type": "string"
    },
    "receiverLabel": {
      "type": "string"
    },
    "selectedText": {
      "type": "string"
    },
    "selectionKind": {
      "$ref": "#/$defs/SelectionKind"
    },
    "sourceSegmentId": {
      "type": "string"
    },
    "sourceVersionId": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "startedAtMs": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": [
        "integer",
        "null"
      ]
    },
    "status": {
      "$ref": "#/$defs/TaskStatus"
    },
    "translationVersionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "updatedAtMs": {
      "format": "int64",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    }
