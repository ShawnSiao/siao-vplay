  "required": [
    "id",
    "projectId",
    "handoffKind",
    "execution",
    "protocolVersion",
    "status",
    "stage",
    "progress",
    "receiverLabel",
    "materialScope",
    "sourceVersionId",
    "translationVersionId",
    "sourceSegmentId",
    "selectedText",
    "selectionKind",
    "playbackPositionMs",
    "expectedProjectRevision",
    "outputDictionaryEntryId",
    "errorCode",
    "errorMessage",
    "createdAtMs",
    "updatedAtMs",
    "startedAtMs",
    "completedAtMs"
